{
  "name": "rabbit-hole-map",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "icons": "node gen-icons.mjs",
    "test": "npm run build && node --test tests/model.test.mjs tests/gameplay.test.mjs tests/storage.test.mjs tests/force.test.mjs tests/view.test.mjs tests/version.test.mjs",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "bump": "node scripts/bump.mjs",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/release.mjs --publish",
    "assets": "npm run build && node marketing/capture.mjs",
    "assets:video": "npm run build && node marketing/video.mjs",
    "e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.0.280",
    "esbuild": "^0.24.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^23.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0"
  }
}
